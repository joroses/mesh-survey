    <string name="survey_status_lora_changed">Ended: LoRa settings changed</string>
    <string name="survey_status_radio_lost">Ended: radio did not come back</string>
    <string name="survey_status_interrupted">Ended: app was closed</string>
    <string name="survey_upload">Upload to SigSleuth</string>
    <string name="survey_upload_off">Off. Measurements stay on this phone, and each session can still be exported as CSV.</string>
    <string name="survey_upload_set_up">Set up</string>
    <string name="survey_upload_edit">Edit</string>
    <string name="survey_upload_url">SigSleuth URL</string>
    <string name="survey_upload_url_hint">Leave it empty to turn uploads off.</string>
    <string name="survey_upload_url_invalid">Enter the full address, starting with https://</string>
    <string name="survey_upload_user">User (optional)</string>
    <string name="survey_upload_password">Password (optional)</string>
    <string name="survey_upload_show_password">Show password</string>
    <string name="survey_upload_hide_password">Hide password</string>
    <string name="survey_upload_automatic">Upload automatically</string>
    <string name="survey_upload_automatic_explained">Every minute while recording, and when a session ends.</string>
    <string name="survey_save">Save</string>
    <string name="survey_upload_now">Upload now</string>
    <string name="survey_uploading">Uploading…</string>
    <plurals name="survey_upload_pending">
        <item quantity="one">%1$d measurement waiting to upload</item>
        <item quantity="other">%1$d measurements waiting to upload</item>
    </plurals>
    <string name="survey_upload_done">Everything is uploaded.</string>
    <string name="survey_upload_failed">Last upload failed: %1$s</string>
    <string name="survey_upload_failed_password">Last upload failed: %1$s. Check the password.</string>
    <string name="survey_sessions">Sessions</string>
    <string name="survey_no_sessions">No sessions yet</string>
    <string name="survey_no_sessions_hint">Each recording appears here, ready to upload or export.</string>
    <string name="survey_uploaded_of">Uploaded %1$d of %2$d</string>
    <string name="survey_uploaded_all">All uploaded</string>
    <string name="survey_server_kept">SigSleuth kept %1$d and skipped %2$d</string>
    <string name="survey_server_kept_reasons">SigSleuth kept %1$d and skipped %2$d: %3$s</string>
