<!-- English only, kept out of core:resources so upstream string changes never conflict with the fork. -->
<resources>
    <string name="survey_title">Signal Survey</string>
    <string name="survey_back">Back</string>
    <string name="survey_intro">Map where your mesh reaches. While recording, each packet your radio hears is saved with your location and its signal strength. Upload sessions to a SigSleuth server or export them as CSV. Keep the radio connected and location on.</string>
    <string name="survey_not_recording">Not recording</string>
    <string name="survey_recording">Recording</string>
    <!-- The notification's text while the radio is away; the screen uses the two strings after it. -->
    <string name="survey_waiting_for_radio">Waiting for radio (GPS paused)</string>
    <string name="survey_waiting_title">Waiting for radio</string>
    <string name="survey_waiting_explained">GPS is paused and nothing is recorded until the radio reconnects. The session ends if it stays away for %1$d minutes.</string>
    <string name="survey_radio_connected">Radio: %1$s</string>
    <string name="survey_radio_none">No radio connected</string>
    <string name="survey_start">Start</string>
    <string name="survey_stop">Stop</string>
    <!-- %1$s is the radio's name, %2$s its preset (LongFast) or spreading factor (SF11), %3$s the frequency. -->
    <string name="survey_node">%1$s · %2$s</string>
    <string name="survey_node_frequency">%1$s · %2$s · %3$s MHz</string>
    <plurals name="survey_measurements">
        <item quantity="one">%1$d measurement</item>
        <item quantity="other">%1$d measurements</item>
    </plurals>
    <string name="survey_stat_measurements">Measurements</string>
    <string name="survey_stat_relays">Relay bytes</string>
    <string name="survey_stat_since_last">Since last packet</string>
    <string name="survey_seconds">%1$d s</string>
    <string name="survey_minutes">%1$d min</string>
    <string name="survey_hours">%1$d h</string>
    <string name="survey_gps">GPS ±%1$s m, fix %2$s s old</string>
    <string name="survey_gps_none">No GPS fix yet</string>
    <!-- %1$d and %2$d are SigSleuth's limits, in seconds and metres. -->
    <string name="survey_gps_skipped">SigSleuth skips packets heard now: it needs a fix at most %1$d s old and within %2$d m.</string>
    <string name="survey_last_signal">Last packet: SNR %1$s dB, RSSI %2$s dBm</string>
    <string name="survey_last_relay">Relay: %1$s</string>
    <!-- Relay guesses: %1$s is the relay byte in hex (3f), %2$s a node's short name. "≈" and "?" mark them as guesses. -->
    <string name="survey_relay_direct">%1$s (direct)</string>
    <string name="survey_relay_likely">%1$s ≈ %2$s</string>
    <string name="survey_relay_possible">%1$s ≈ %2$s?</string>
    <string name="survey_relay_ambiguous">%1$s: %2$s</string>
    <string name="survey_relay_or">%1$s or %2$s</string>
    <string name="survey_relays_open">Show relays</string>
    <string name="survey_relays_title">Relays this session</string>
    <string name="survey_relays_explained">≈ likely: the only node with that byte heard directly within 1 km of here. ? possible: none heard near here, one heard elsewhere in the last 30 days. Distances are from the nearest place this phone heard the node directly, not from the node.</string>
    <plurals name="survey_relay_packets">
        <item quantity="one">%1$d packet, last %2$s</item>
        <item quantity="other">%1$d packets, last %2$s</item>
    </plurals>
    <!-- %2$s and %4$s are relative times ("3 min. ago"), %3$s a distance. -->
    <string name="survey_relay_candidate">%1$s: heard directly %2$s</string>
    <string name="survey_relay_candidate_at">%1$s: heard directly %2$s, %3$s from here</string>
    <string name="survey_relay_candidate_earlier">%1$s: heard directly %2$s, nearest reception %3$s from here (%4$s)</string>
    <string name="survey_distance_m">%1$d m</string>
    <string name="survey_distance_km">%1$s km</string>
    <string name="survey_close">Close</string>
    <!-- Why the last session ended on its own; shown until the next one starts. -->
    <string name="survey_ended_node_changed">The last session ended because another radio connected.</string>
    <string name="survey_ended_lora_changed">The last session ended because the radio\'s LoRa settings changed. Start again to record with the new settings.</string>
    <string name="survey_ended_radio_lost">The last session ended because the radio was away for %1$d minutes.</string>
    <string name="survey_ended_interrupted">The last session ended because Android stopped the app.</string>
    <string name="survey_problem_no_radio">Connect a radio first.</string>
    <string name="survey_problem_no_lora">The radio has not sent its LoRa settings yet. Try again in a moment.</string>
    <string name="survey_problem_no_location">Turn on location and allow precise location.</string>
