<!-- English only, kept out of core:resources so upstream string changes never conflict with the fork. -->
<resources>
    <string name="survey_title">Signal Survey</string>
    <!-- The launcher shortcut's short label, under its icon on the home screen. -->
    <string name="survey_shortcut">Survey</string>
    <string name="survey_back">Back</string>
    <string name="survey_intro">Track which nodes are relaying packets to your radio.</string>
    <string name="survey_not_recording">Not recording</string>
    <string name="survey_recording">Recording</string>
    <!-- The notification's text while the radio is away; the screen uses the two strings after it. -->
    <string name="survey_waiting_for_radio">Waiting for radio (GPS paused)</string>
    <string name="survey_waiting_title">Waiting for radio</string>
    <string name="survey_waiting_explained">GPS is paused and nothing is recorded until the radio reconnects. The session ends if it stays away for %1$d minutes.</string>
    <string name="survey_radio_none">No radio connected</string>
    <string name="survey_start">Start</string>
    <string name="survey_stop">Stop</string>
    <!-- Top bar chip: while recording, keeps the screen on and shows the figures in big type, to read at a glance in a car. -->
    <string name="survey_car_mode">Car mode</string>
    <!-- %1$s is the radio's name, %2$s its preset (LongFast) or spreading factor (SF11), %3$s the frequency. -->
    <string name="survey_node">%1$s · %2$s</string>
    <string name="survey_node_frequency">%1$s · %2$s · %3$s MHz</string>
    <plurals name="survey_measurements">
        <item quantity="one">%1$d measurement</item>
        <item quantity="other">%1$d measurements</item>
    </plurals>
    <!-- The notification's text, the recording card's three figures: distinct cells, relay bytes and senders heard directly. -->
    <string name="survey_notification_stats">Cells %1$d · Relays %2$d · Heard directly %3$d</string>
    <!-- What a session added that no earlier session on this phone had, on the same LoRa settings: %1$s lists it ("4 cells · a new relay in 9 cells · a new direct node in 1 cell"). A relay or direct node is new in a cell when no earlier session heard it there. -->
    <string name="survey_new_to_you">New to you: %1$s</string>
    <string name="survey_nothing_new">Nothing new to you yet</string>
    <plurals name="survey_cells">
        <item quantity="one">%1$d cell</item>
        <item quantity="other">%1$d cells</item>
    </plurals>
    <plurals name="survey_new_relay_cells">
        <item quantity="one">a new relay in %1$d cell</item>
        <item quantity="other">a new relay in %1$d cells</item>
    </plurals>
    <plurals name="survey_new_direct_cells">
        <item quantity="one">a new direct node in %1$d cell</item>
        <item quantity="other">a new direct node in %1$d cells</item>
    </plurals>
    <!-- Cells SigSleuth's map gained from these uploads, as its replies said. -->
    <plurals name="survey_cells_added">
        <item quantity="one">%1$d cell added to the map</item>
        <item quantity="other">%1$d cells added to the map</item>
    </plurals>
    <!-- A session card's figures: distinct cells, relay bytes and senders heard directly where it had a fix, each with what was new to this phone under it. -->
    <string name="survey_stat_cells">Cells</string>
    <string name="survey_stat_relays_heard">Relays</string>
    <string name="survey_stat_direct">Direct</string>
    <!-- Beside Direct while recording: every packet this session has recorded. -->
    <string name="survey_stat_packets">Packets</string>
    <!-- Under a session's cell count: cells no earlier session on this phone had. -->
    <string name="survey_stat_new">+%1$d new</string>
    <!-- Under a session's cell count, once SigSleuth has answered: the cells its map did not have. -->
    <string name="survey_stat_added">%1$d added to map</string>
    <!-- Under a session's relay or direct count: the cells where one was heard there for the first time on this phone. -->
    <plurals name="survey_stat_new_in_cells">
        <item quantity="one">new in %1$d cell</item>
        <item quantity="other">new in %1$d cells</item>
    </plurals>
    <!-- The card under Sessions: every session on this phone together. Cells count once per LoRa settings; direct nodes once. -->
    <string name="survey_totals">Surveyed so far</string>
    <!-- Beside the totals' cells and direct nodes: the cells SigSleuth's map gained, worded like survey_stat_added. -->
    <string name="survey_totals_map">Added to map</string>
    <!-- A session's upload state, beside its date. -->
    <string name="survey_session_waiting">Waiting to upload</string>
    <!-- Over the last packet's signal when its relay byte is unknown: %1$s is how long ago it came ("12 s ago"). -->
    <string name="survey_last_packet">Last packet · %1$s</string>
    <!-- Over the last packet's signal: %1$s is its relay byte ("0x3f"), %2$s how long ago it came ("12 s ago"). -->
    <string name="survey_last_packet_relay">Last packet: %1$s · %2$s</string>
    <string name="survey_no_packet">No packet yet</string>
    <!-- %1$s is a duration ("12 s", "3 min", "2 h"). -->
    <string name="survey_ago">%1$s ago</string>
    <string name="survey_seconds">%1$d s</string>
    <string name="survey_minutes">%1$d min</string>
    <string name="survey_hours">%1$d h</string>
    <string name="survey_gps">GPS ±%1$s m, fix %2$s s old</string>
    <string name="survey_gps_none">No GPS fix yet</string>
    <!-- The recording header's GPS mark; a tap shows survey_gps or survey_gps_none. -->
    <string name="survey_gps_label">GPS</string>
    <!-- The GPS mark's state, read by screen readers: whether SigSleuth can place packets heard now. -->
    <string name="survey_gps_usable">Good enough to place packets</string>
    <string name="survey_gps_unusable">Not good enough to place packets</string>
    <!-- %1$d and %2$d are SigSleuth's limits, in seconds and metres. -->
    <string name="survey_gps_skipped">SigSleuth skips packets heard now: it needs a fix at most %1$d s old and within %2$d m.</string>
    <!-- The last packet's signal: %1$s is the SNR with its unit ("-6.00 dB"), drawn as a chip in its fade margin's colour, or "–"; %2$s the RSSI. -->
    <string name="survey_last_signal">SNR %1$s, RSSI %2$s dBm</string>
    <!-- survey_last_signal in car mode, where the text is bigger: the chip's colour and unit say it is the SNR. -->
    <string name="survey_last_signal_brief">%1$s · RSSI %2$s dBm</string>
    <!-- An SNR value: %1$s is the number. -->
    <string name="survey_snr">%1$s dB</string>
    <!-- The packet was not relayed: %1$s is the relay byte, which is the sender's own ("0x3f"), %2$s the sender's short name. -->
    <string name="survey_relay_direct">%1$s → %2$s (direct)</string>
    <!-- Who relayed a packet: %1$s is the relay byte in hex ("0x3f"), %2$s one short name or several joined by survey_relay_or. -->
    <string name="survey_relay_named">%1$s → %2$s</string>
    <string name="survey_relay_or">%1$s or %2$s</string>
    <string name="survey_relays_open">Show relays</string>
    <string name="survey_relays_title">Relays</string>
    <!-- The relays list when no packet has carried a relay byte yet. -->
    <string name="survey_relays_none">No relays heard</string>
    <!-- An ended session's relays could not be read from the phone's storage. -->
    <string name="survey_relays_failed">Could not read this session</string>
    <!-- Marks beside a relay byte, read out by screen readers. -->
    <string name="survey_relay_confirmed">Confirmed by SigSleuth</string>
    <string name="survey_relay_likely">Likely guess</string>
    <string name="survey_relay_uncertain">Uncertain guess</string>
    <string name="survey_relay_unknown">Unknown relay</string>
    <!-- A relay row's state, read by screen readers: the last packet came through this relay. -->
    <string name="survey_relay_latest">Relayed the last packet</string>
    <!-- What tapping a relay row does, read by screen readers. -->
    <string name="survey_relay_show">Show details</string>
    <string name="survey_relay_hide">Hide details</string>
    <!-- Read out by screen readers for a relay candidate known by the position it reports, before its distance. -->
    <string name="survey_relay_reported_position">Reported position</string>
    <!-- SigSleuth's answer for an uploaded packet with this relay byte: %1$s the node's short name, %2$s how SigSleuth knows, %3$s when the packet was heard ("3 min. ago"). -->
    <string name="survey_relay_server">SigSleuth: %1$s, %2$s · %3$s</string>
    <!-- As survey_relay_server, when the relay byte's line above already names the same node: %1$s how SigSleuth knows, %2$s when the packet was heard. -->
    <string name="survey_relay_server_same">SigSleuth: %1$s · %2$s</string>
    <string name="survey_relay_server_unknown">SigSleuth: unknown · %1$s</string>
    <string name="survey_server_direct">heard directly</string>
    <string name="survey_server_survey_link">heard nearby by a survey</string>
    <string name="survey_server_gateway_link">linked to a gateway that heard it</string>
    <string name="survey_server_sender_link">linked to the sender</string>
    <string name="survey_server_reported">says it relayed it</string>
    <string name="survey_server_only_candidate">the only one that could</string>
    <!-- SigSleuth's answer with the evidence behind it, in place of the packet's time: %1$s the node's short name, %2$s where and when the node was heard directly ("heard directly by you 2.3 km away, 29 days ago"). -->
    <string name="survey_relay_server_evidence">SigSleuth: %1$s, %2$s</string>
    <!-- As survey_relay_server_evidence, when the relay byte's line above already names the same node: %1$s where and when the node was heard directly. -->
    <string name="survey_relay_server_evidence_same">SigSleuth: %1$s</string>
    <!-- This survey radio heard the relay directly: %1$s how far from the packet ("2.3 km"), %2$s a relative time ("29 days ago"). -->
    <string name="survey_server_survey_link_mine">heard directly by you %1$s away, %2$s</string>
    <!-- Another survey radio heard the relay directly: %1$s how far from the packet ("12 km"), %2$s a relative time ("3 h ago"). -->
    <string name="survey_server_survey_link_other">heard directly by another survey %1$s away, %2$s</string>
    <!-- As survey_server_survey_link_mine, with the reception's RSSI: %1$s how far ("2.3 km"), %2$d the RSSI in dBm (negative), %3$s a relative time ("29 days ago"). -->
    <string name="survey_server_survey_link_mine_rssi">heard directly by you %1$s away at %2$d dBm, %3$s</string>
    <!-- As survey_server_survey_link_other, with the reception's RSSI: %1$s how far ("12 km"), %2$d the RSSI in dBm (negative), %3$s a relative time ("3 h ago"). -->
    <string name="survey_server_survey_link_other_rssi">heard directly by another survey %1$s away at %2$d dBm, %3$s</string>
    <plurals name="survey_relay_packets">
        <item quantity="one">%1$d packet</item>
        <item quantity="other">%1$d packets</item>
    </plurals>
    <!-- An opened relay row: %1$s the packet count ("18 packets"), %2$d the last packet's RSSI in dBm (negative). -->
    <string name="survey_relay_rssi">%1$s · %2$d dBm</string>
    <!-- This phone heard the candidate directly; the packet had no GPS fix to measure from: %1$s is a relative time ("3 min. ago"). -->
    <string name="survey_relay_candidate">heard directly %1$s</string>
    <!-- %1$s is the distance from where the packet was heard to where this phone heard the candidate directly, %2$s a relative time. -->
    <string name="survey_relay_candidate_at">heard directly %1$s away · %2$s</string>
    <!-- This phone heard the candidate directly, but has no record of where or when. -->
    <string name="survey_relay_candidate_heard">heard directly</string>
    <!-- %1$s is the distance from where the packet was heard to the position the candidate reports. -->
    <string name="survey_relay_candidate_reported_at">%1$s away</string>
    <string name="survey_relay_candidate_reported">within %1$s</string>
    <!-- %1$s is the distance from where the packet was heard to where SigSleuth's map puts the candidate. -->
    <string name="survey_relay_candidate_mapped_at">%1$s away on SigSleuth\'s map</string>
    <string name="survey_relay_candidate_mapped">within %1$s on SigSleuth\'s map</string>
    <!-- %1$s is a candidate's line, %2$s the longest link SigSleuth trusts it to have sent. -->
    <string name="survey_relay_candidate_reach">%1$s · reaches %2$s</string>
    <!-- A node ruled out as the relay because the packet arrived far stronger than the node is ever heard here: %1$d is this packet's signal in dBm, %2$d the node's strongest heard near here, both negative. -->
    <string name="survey_relay_ruled_out">too strong: %1$d dBm, best here %2$d</string>
    <string name="survey_distance_m">%1$d m</string>
    <string name="survey_distance_km">%1$s km</string>
    <!-- A distance to a position SigSleuth estimated from the node's neighbours. -->
    <string name="survey_distance_about">~%1$s</string>
    <!-- Why the last session ended on its own; shown until the next one starts. -->
    <string name="survey_ended_node_changed">The last session ended because another radio connected.</string>
    <string name="survey_ended_lora_changed">The last session ended because the radio\'s LoRa settings changed. Start again to record with the new settings.</string>
    <string name="survey_ended_radio_lost">The last session ended because the radio was away for %1$d minutes.</string>
    <string name="survey_ended_interrupted">The last session ended because Android stopped the app.</string>
    <string name="survey_problem_no_radio">Connect a radio first.</string>
    <string name="survey_problem_no_lora">The radio has not sent its LoRa settings yet. Try again in a moment.</string>
    <string name="survey_problem_no_location">Turn on location and allow precise location.</string>
    <string name="survey_problem_storage">Could not save to the survey database.</string>
    <string name="survey_open_settings">Open settings</string>
    <string name="survey_status_recording">Recording</string>
    <string name="survey_status_stopped">Stopped</string>
    <string name="survey_status_node_changed">Ended: another radio</string>
    <string name="survey_status_lora_changed">Ended: LoRa settings changed</string>
    <string name="survey_status_radio_lost">Ended: radio did not come back</string>
    <string name="survey_status_interrupted">Ended: app was closed</string>
    <string name="survey_upload">Upload to SigSleuth</string>
    <!-- The upload card before a server is set: uploads need a SigSleuth server. -->
    <string name="survey_upload_set_up_prompt">Send surveys to a SigSleuth server</string>
    <string name="survey_upload_set_up">Set up</string>
    <string name="survey_upload_edit">Edit</string>
    <string name="survey_upload_url">SigSleuth server</string>
    <!-- https:// is added when no scheme is typed, so this shows for a typed http:// to another host, or a bad address. -->
    <string name="survey_upload_url_invalid">Not a server address. http:// works only for localhost.</string>
    <string name="survey_upload_user">User</string>
    <string name="survey_upload_password">Password</string>
    <string name="survey_upload_show_password">Show password</string>
    <string name="survey_upload_hide_password">Hide password</string>
    <string name="survey_upload_automatic">Upload automatically</string>
    <!-- The short label beside the upload card's small automatic-upload switch. -->
    <string name="survey_upload_auto">Auto</string>
    <string name="survey_save">Save</string>
    <string name="survey_upload_now">Upload now</string>
    <string name="survey_upload_session">Upload</string>
    <string name="survey_uploading">Uploading…</string>
    <plurals name="survey_upload_pending">
        <item quantity="one">%1$d measurement waiting to upload</item>
        <item quantity="other">%1$d measurements waiting to upload</item>
    </plurals>
    <string name="survey_upload_done">Everything is uploaded.</string>
    <!-- The recording header's upload button, read by screen readers when measurements wait or the last upload failed. -->
    <string name="survey_upload_mark_waiting">Upload to SigSleuth: measurements waiting</string>
    <string name="survey_upload_mark_failed">Upload to SigSleuth: the last upload failed</string>
    <plurals name="survey_upload_past_waiting">
        <item quantity="one">%1$d past session waiting to upload</item>
        <item quantity="other">%1$d past sessions waiting to upload</item>
    </plurals>
    <!-- The upload card's waiting line, which uploads those sessions when tapped. -->
    <plurals name="survey_upload_past_waiting_tap">
        <item quantity="one">%1$d past session waiting · tap to upload</item>
        <item quantity="other">%1$d past sessions waiting · tap to upload</item>
    </plurals>
    <string name="survey_upload_all">Upload all</string>
    <string name="survey_upload_failed">Last upload failed: %1$s</string>
    <string name="survey_upload_failed_password">Last upload failed: %1$s. Check the password.</string>
    <!-- The server's name could not be looked up, which is how having no internet shows. -->
    <string name="survey_upload_failed_offline">Last upload failed: no internet connection, or the server name is wrong.</string>
    <string name="survey_sessions">Sessions</string>
    <string name="survey_no_sessions">No sessions yet</string>
    <string name="survey_no_sessions_hint">Each recording appears here, ready to upload or export.</string>
    <string name="survey_uploaded_of">Uploaded %1$d of %2$d</string>
    <string name="survey_uploaded_all">Uploaded</string>
    <string name="survey_server_kept">SigSleuth kept %1$d and skipped %2$d</string>
    <string name="survey_server_kept_all">SigSleuth kept %1$d</string>
    <string name="survey_export">Export CSV</string>
    <!-- The menu on a session card holding Export CSV and Delete. -->
    <string name="survey_session_actions">Session actions</string>
    <string name="survey_export_saved">CSV saved.</string>
    <string name="survey_export_failed">Could not save the CSV.</string>
    <string name="survey_delete">Delete</string>
    <string name="survey_delete_title">Delete this session?</string>
    <string name="survey_delete_text">%1$d of its %2$d measurements are uploaded. The rest are lost unless you export them first.</string>
    <string name="survey_delete_text_uploaded">All %1$d measurements are uploaded. Export them first if you want a copy.</string>
    <!-- SigSleuth answered for rows it skipped (no position, old fix) without storing them. -->
    <string name="survey_delete_text_kept">SigSleuth kept %1$d of its %2$d measurements. The rest are only on this phone and are lost unless you export them first.</string>
    <string name="survey_delete_text_empty">It has no measurements.</string>
    <string name="survey_deleted">Session deleted.</string>
    <string name="survey_delete_failed">Could not delete the session.</string>
    <string name="survey_cancel">Cancel</string>
</resources>
