    <string name="survey_skip_no_position">%1$d without a position</string>
    <string name="survey_skip_inaccurate">%1$d with a fix worse than %2$d m</string>
    <string name="survey_skip_old_fix">%1$d with a fix older than %2$d s</string>
    <string name="survey_skip_too_old">%1$d older than SigSleuth keeps</string>
    <string name="survey_skip_in_future">%1$d timed in the future</string>
    <string name="survey_skip_no_sender">%1$d without a sender</string>
    <!-- A reason this version does not know; %2$s is SigSleuth's own name for it. -->
    <string name="survey_skip_other">%1$d %2$s</string>
    <string name="survey_export">Export CSV</string>
    <string name="survey_export_saved">CSV saved.</string>
    <string name="survey_export_failed">Could not save the CSV.</string>
    <string name="survey_delete">Delete</string>
    <string name="survey_delete_title">Delete this session?</string>
    <string name="survey_delete_text">%1$d of its %2$d measurements are uploaded. The rest are lost unless you export them first.</string>
    <string name="survey_delete_text_uploaded">All %1$d measurements are uploaded. Export them first if you want a copy.</string>
    <!-- SigSleuth answered for rows it skipped (no position, old fix) without storing them. -->
    <string name="survey_delete_text_kept">SigSleuth kept %1$d of its %2$d measurements. The rest are only on this phone and are lost unless you export them first.</string>
    <string name="survey_delete_text_empty">It has no measurements.</string>
